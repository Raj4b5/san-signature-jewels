# ---------------------------------------------------------------------
# Copy this file to .env and fill in the values.
# Restart with `npx expo start -c` after any change: these are inlined
# at build time, not read at runtime.
#
# EXPO_PUBLIC_* values are visible in the shipped app. That is fine for
# these two -- the anon key is designed to be public and is constrained
# by row level security. NEVER put the service role key or the Razorpay
# secret here; those live only in Supabase Edge Function secrets.
# ---------------------------------------------------------------------

# Supabase > Project Settings > Data API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
